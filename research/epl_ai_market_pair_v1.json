{
  "experiment_id": "EPL_AI_MARKET_PAIR_V1",
  "status": "FROZEN_RESEARCH_ONLY",
  "league": "EPL",
  "market": "1X2",
  "purpose": "Collect reproducible Football AI and canonical fair-market probabilities for the same EPL decision snapshots without reading target outcomes.",
  "collection": {
    "prediction_mode": "MARKET_ONLY",
    "market_decision": "latest durably recorded pre-kickoff league_prediction_ledger row observed by the collector",
    "exact_market_price_authority": "odds_snapshots",
    "model": "football_model_xgboost_elo.pkl",
    "model_semantics": "production model consuming the exact recorded 1X2 odds plus football-state features available as of the same market snapshot",
    "model_artifact_last_changed_before_experiment": "2026-08-03T15:32:10Z",
    "feature_formula_last_changed_before_experiment": "2026-08-07T16:14:45Z",
    "team_name_normalizer": "team_names.normalize_team_name",
    "history_timezone": "Europe/London",
    "result_availability_buffer_hours": 4,
    "one_record_per": "event_id + market_snapshot_time_utc + model_artifact_sha256",
    "append_only": true,
    "outcomes_read_by_collector": false
  },
  "point_in_time_guards": {
    "market_snapshot_before_kickoff": true,
    "exact_market_odds_reproduce_stored_fair_probabilities": true,
    "model_artifact_predates_market_snapshot": true,
    "feature_formula_predates_market_snapshot": true,
    "history_as_of_market_snapshot": "include prior local dates; on the same local date include only matches whose Europe/London kickoff + 4 hours is <= market snapshot",
    "missing_same_day_match_time": "exclude_from_history_fail_closed",
    "target_fixture_absent_from_model_history": true,
    "unknown_normalized_team_at_decision_time": "exclude_fail_closed",
    "ambiguous_provider_revision": "exclude_fail_closed",
    "market_probability_mismatch": "exclude_fail_closed"
  },
  "stored_provenance": [
    "league",
    "event_id",
    "provider_home_team",
    "provider_away_team",
    "model_home_team",
    "model_away_team",
    "kickoff_utc",
    "market_snapshot_time_utc",
    "model_generated_at_utc",
    "market_home_odds",
    "market_draw_odds",
    "market_away_odds",
    "market_home_prob",
    "market_draw_prob",
    "market_away_prob",
    "model_home_prob",
    "model_draw_prob",
    "model_away_prob",
    "model_artifact_sha256",
    "code_commit_sha",
    "history_cutoff_utc",
    "history_max_match_date",
    "history_rows"
  ],
  "interpretation_guard": "This experiment tests whether the deployed market-plus-football production model improves probabilistic scoring over the same fair market. It is not a football-only structural-alpha test.",
  "evaluation": {
    "automatic": false,
    "collector_reads_target_outcomes": false,
    "paired_audit": "market_model_incremental_audit.py",
    "primary_metrics": ["multiclass_brier", "multiclass_log_loss"],
    "score_delta": "model_minus_market",
    "interpretation": "negative deltas favor the production model",
    "threshold_search": false,
    "production_activation": false,
    "model_promotion": false
  }
}
